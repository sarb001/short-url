<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     <h1>  Urls Shortener  </h1>
      <form method="post" action = "/url/createurl">
        <p> Enter your Original URL </p>
          <input type = "text" 
           name="mainurl"
          placeholder="Enter original URL"  
          placeholder = "http://exmaple.com" 
            />
        <button type = "submit"> Generate </button>
      </form>
     <% if(locals.id) { %>
        <p> URL Generated : http://localhost:8000/url/<%= id %> </p>
     <% } %>
</body>
</html>